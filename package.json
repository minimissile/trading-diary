{
  "name": "trading-diary",
  "productName": "交易日记",
  "version": "1.0.1",
  "description": "面向本地优先场景的交易日记桌面客户端",
  "main": "./out/main/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/minimissile/trading-diary.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepackage": "npm run clean:dist",
    "package": "npm run build && electron-builder --dir -c.mac.identity=-",
    "predist": "npm run clean:dist",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "predist:mac": "npm run clean:dist",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "predist:win": "npm run clean:dist",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "predist:publish": "npm run clean:dist",
    "dist:publish": "npm run build && electron-builder --config electron-builder.config.cjs --publish always",
    "predist:mac:publish": "npm run clean:dist",
    "dist:mac:publish": "npm run build && electron-builder --config electron-builder.config.cjs --mac --publish always",
    "predist:win:publish": "npm run clean:dist",
    "dist:win:publish": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish always",
    "rebuild:native": "electron-builder install-app-deps",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@11.3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "antd": "^6.6.1",
    "dayjs": "^1.11.23",
    "electron-updater": "^6.8.9",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
