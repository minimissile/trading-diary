# 发布到 GitHub Releases 时使用（本地 --publish 或 CI 工作流）。
# 在 https://github.com/settings/tokens 创建 classic token，勾选 repo 权限。
GH_TOKEN=

# 可选：覆盖默认 GitHub 仓库（默认 minimissile/trading-diary）
# GH_OWNER=minimissile
# GH_REPO=trading-diary

# 可选：release | draft | prerelease
# GH_RELEASE_TYPE=release

# 可选：OpenRouter 大模型 API，用于一键发布时自动生成面向用户的更新说明
# 在 https://openrouter.ai/keys 创建
OPENROUTER_API_KEY=

# 可选：OpenRouter 模型 ID（默认 anthropic/claude-sonnet-4）
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
